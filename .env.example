# =============================================================================
# Guest Access Configuration
# =============================================================================

## Password for protected pages/routes
PAGE_ACCESS_PASSWORD=password

# =============================================================================
# SSO Service Configuration
# =============================================================================

## SSO Service URL (Multitenant-User-Management-Service)
NEXT_PUBLIC_SSO_URL=http://localhost:5500

## Tenant ID for this application
NEXT_PUBLIC_TENANT_ID=your-tenant-id-here

## API Key for SSO service authentication
NEXT_PUBLIC_API_KEY=your-api-key-here

# =============================================================================
# Backend API Configuration
# =============================================================================

## Backend Service URL (Portfolio-Backend-Service)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080
