#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
ZERO_SHA="0000000000000000000000000000000000000000"
needs_guard=0

while read -r _local_ref local_sha remote_ref remote_sha; do
  [[ "$remote_ref" == refs/heads/main ]] || continue
  needs_guard=1
  if [[ "$local_sha" == "$ZERO_SHA" || "$remote_sha" == "$ZERO_SHA" ]]; then
    echo 'pre-push: refusing main create/delete because there is no bounded diff range' >&2
    exit 78
  fi
done

[[ "$needs_guard" -eq 1 ]] || exit 0
"$ROOT/.agents/scripts/engineering-guard.sh" portfolio full
bash -n "$ROOT/.agents/scripts/engineering-guard.sh" "$ROOT/.agents/scripts/codebase-policy.sh" "$ROOT/.githooks/pre-push"
git diff --check
