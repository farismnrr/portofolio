FROM node:22-bookworm-slim

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
# Install dependencies and curl for healthcheck
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*
RUN npm install

# Copy source code (will be overridden by bind mount, but good for image completeness)
COPY . .

# Run dev server
CMD ["npm", "run", "dev"]
