{
  "name": "portfolio-ui",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "build": "node ./scripts/check-cv-profiles.mjs && node ./scripts/build-cv-corpus.mjs && node ./scripts/generate-seo-assets.mjs && node ./scripts/prepare-mermaid-vendor.mjs && vite build && vite build --ssr src/entry-server.ts --outDir .ssr && node ./scripts/prerender.mjs && node ./scripts/verify-prerender.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "content:check": "node ./scripts/check-content.mjs",
    "cv:check": "node ./scripts/check-cv-profiles.mjs",
    "seo:generate": "node ./scripts/generate-seo-assets.mjs",
    "guard": "node ./scripts/guard-ui.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tabler/icons-svelte-runes": "^3.48.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.1.0",
    "daisyui": "^5.1.0",
    "marked": "^18.0.14",
    "mermaid": "^12.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "jsdom": "^30.1.1"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  },
  "dependencies": {
    "@langchain/core": "^1.2.14",
    "@langchain/langgraph": "^1.4.18"
  }
}
