{
  "name": "portfolio-ui",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "npm run media:prepare && vite",
    "build": "npm run media:prepare && node ./scripts/check-cv-profiles.mjs && node ./scripts/build-cv-corpus.mjs && node ./scripts/generate-seo-assets.mjs && node ./scripts/prepare-mermaid-vendor.mjs && vite build && node ./scripts/prune-project-source-images.mjs && vite build --ssr src/lib/entry-server.ts --outDir .ssr && node ./scripts/prerender.mjs && node ./scripts/verify-prerender.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "content:check": "node ./scripts/check-experience-duration.mjs && node ./scripts/check-content.mjs && node ./scripts/check-writing-style.mjs --base origin/main",
    "content:style": "node ./scripts/check-writing-style.mjs",
    "cv:check": "node ./scripts/check-cv-profiles.mjs",
    "media:prepare": "node ./scripts/prepare-profile-image.mjs && node ./scripts/prepare-blog-image.mjs && node ./scripts/prepare-certification-images.mjs && node ./scripts/prepare-project-images.mjs",
    "seo:generate": "node ./scripts/generate-seo-assets.mjs",
    "guard": "node ./scripts/guard-ui.mjs",
    "cv:publish": "node ./scripts/publish-cv.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tabler/icons-svelte-runes": "^3.48.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.1.0",
    "jsdom": "^30.1.1",
    "marked": "^18.0.14",
    "mermaid": "^12.0.0",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.35.5",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
