    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "sass": "^1.90.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vue-tsc": "^3.0.0"
  }
}
