{
  "name": "faris-portfolio",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3006",
    "build": "node scripts/build.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 3006",
    "typecheck": "vue-tsc --noEmit",
